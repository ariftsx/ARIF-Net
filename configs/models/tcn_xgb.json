{
  "family": "tcn_xgb",
  "_source": "Zhao et al. (2025): TCN 6 layer, kernel 3, dilasi 1..32, dropout 0,3, WeightNorm, window 30 → XGBoost depth 10, lr 0,03, subsample 1,0, lambda 1,2, loss kuadrat",
  "stage1": {
    "model": {
      "name": "tcn",
      "d": 32,
      "kernel": 3,
      "levels": 6,
      "dropout": 0.3,
      "emb": 8
    },
    "train": {
      "loss": "mse",
      "lr": 0.001,
      "weight_decay": 0.0,
      "batch": 64,
      "epochs": 20,
      "clip": 0.0,
      "threads": "auto",
      "shock_weight": 1.0,
      "L": 30
    }
  },
  "stage2": {
    "features": "embedding",
    "params": {
      "n_estimators": 400,
      "max_depth": 10,
      "learning_rate": 0.03,
      "subsample": 1.0,
      "colsample_bytree": 1.0,
      "min_child_weight": 1,
      "reg_lambda": 1.2,
      "objective": "reg:squarederror"
    }
  }
}
