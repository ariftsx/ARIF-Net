{
  "model": {
    "type": "twostage",
    "stage1": {
      "name": "tcn",
      "d": 32,
      "kernel": 3,
      "levels": 5,
      "dropout": 0.1,
      "emb": 8
    },
    "stage2": {
      "kind": "xgb",
      "features": "embedding",
      "params": { "n_estimators": 400, "max_depth": 4, "learning_rate": 0.03 }
    }
  },
  "train": {
    "steps": 320,
    "batch": 256,
    "lr": 0.001,
    "weight_decay": 0.01,
    "huber_delta": 1.0,
    "clip": 1.0,
    "threads": 2,
    "shock_weight": 2.0
  },
  "description": "TCN-XGBoost hybrid — Zhao et al. (2025): TCN embedding → XGBoost regressor"
}
