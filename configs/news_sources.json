{
  "_meta": {
    "note": "3 media utama untuk collection berita. URL pattern dari project lama yang sudah terverifikasi.",
    "scraping_method": "trafilatura untuk body text, BeautifulSoup untuk index parsing",
    "filter_strategy": "Filter relevansi SEBELUM scraping full article (hemat bandwidth)"
  },
  "period": {
    "start": "2019-01-01",
    "end": "2026-09-30"
  },
  "delay_seconds": 1.0,
  "timeout_seconds": 45,
  "retries": 4,
  "max_pages_per_day": 80,
  "sources": {
    "kompas": {
      "code": "kmp",
      "base_url": "https://indeks.kompas.com",
      "indexes": [
        {
          "name": "news",
          "url": "https://indeks.kompas.com/?site=news&date={date_iso}&page={page}"
        },
        {
          "name": "money",
          "url": "https://indeks.kompas.com/?site=money&date={date_iso}&page={page}"
        }
      ],
      "per_page": 20,
      "time_strategy": "url_kompas"
    },
    "detik": {
      "code": "dtk",
      "base_url": "https://finance.detik.com",
      "indexes": [
        {
          "name": "finance",
          "url": "https://finance.detik.com/indeks?date={date_mdy_enc}&page={page}"
        }
      ],
      "per_page": 20,
      "time_strategy": "index_title_wib"
    },
    "cnnindonesia": {
      "code": "cnn",
      "base_url": "https://www.cnnindonesia.com",
      "indexes": [
        {
          "name": "all",
          "url": "https://www.cnnindonesia.com/indeks/2?date={date_ymd_slash}&page={page}"
        }
      ],
      "per_page": 10,
      "time_strategy": "article_jsonld"
    }
  }
}
